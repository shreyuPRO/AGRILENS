  {"topic": "user interface", "pattern": "tk\\.|RoundedButton|\\.config\\(text=|font=|_build_|translate_",
   "docs": ["deployment/raspberry_pi/HOW_TO_RUN_ON_RASPBERRY_PI.md", "HOW_TO.md"], "tests": []}
 ],
